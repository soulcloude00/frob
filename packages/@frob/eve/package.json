{
  "name": "@frob/eve",
  "version": "0.43.0",
  "description": "eve extension that gives agents a full browser automation tool set backed by frob",
  "type": "module",
  "sideEffects": false,
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./sandbox": {
      "types": "./dist/sandbox/sandbox.d.ts",
      "default": "./dist/sandbox/sandbox.js"
    }
  },
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.sandbox.json",
    "prepare": "pnpm -C ../sandbox run build && pnpm run build",
    "test": "pnpm -C ../sandbox run build && pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc-ts",
    "typecheck:tsc": "tsc"
  },
  "keywords": [
    "frob",
    "eve",
    "eve-extension",
    "browser-automation",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulcloude00/frob",
    "directory": "packages/@frob/eve"
  },
  "bugs": {
    "url": "https://github.com/soulcloude00/frob/issues"
  },
  "homepage": "https://github.com/soulcloude00/frob",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@frob/sandbox": "workspace:^",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "eve": ">=0.84.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "ai": "7.0.102",
    "eve": "0.84.0",
    "tsc-ts": "0.1.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
